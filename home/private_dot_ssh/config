host *
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/ssh-%r@%h:%p

Include "config.d/*"

Host skedaddle.greyrock.io
  User ubuntu
  Port 22222
  SetEnv TERM=xterm-256color

Host 192.168.*.*
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host 172.16.*.*
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host 10.*.*.*
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
